# ─────────────────────────────────────────────────────────────
# Copie este archivo como .env.local (local) o cargue estas
# variables en Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# 1) Sesión (OBLIGATORIA en producción). Cadena aleatoria larga.
#    Genérela con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 2) Persistencia. Si se dejan vacías, la app usa memoria del servidor
#    (los datos se pierden al reiniciar). Para que todos los que abran
#    el enlace vean los mismos cambios, configure Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 3) Motor del chatbot: anthropic | openai | gemini | mock
#    Si no hay API key, se usa automáticamente el modo "Demo inteligente" (mock).
LLM_PROVIDER=mock
LLM_API_KEY=
# Opcional: modelo específico (por defecto: claude-haiku-4-5 / gpt-4o-mini / gemini-2.5-flash)
LLM_MODEL=

# 4) Reglas de negocio
#    true = nadie puede modificar datos (alineado con el documento teórico:
#    chatbot de consulta y visualización de solo lectura).
MODO_SOLO_LECTURA=false
#    Zona horaria para "hoy", vencimientos y sellos de tiempo
APP_TIMEZONE=America/Bogota
#    true = no mostrar los PIN de demostración en la pantalla de acceso
OCULTAR_PINS_DEMO=false
